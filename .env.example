# Copy to .env and fill in real values. Never commit .env.

# GitHub personal access token (fine-grained: Contents read/write + Pull requests read on the target repo)
GITHUB_TOKEN=ghp_your_token_here

# OpenAI key used by propose_refactor_node
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: shared secret configured on the GitHub webhook (enables X-Hub-Signature-256 verification)
GITHUB_WEBHOOK_SECRET=

# Checkpointer backend: "sqlite" (persistent, default) or "memory"
CHECKPOINTER=sqlite
SQLITE_PATH=data/checkpoints.sqlite

# Reviewer rejections allowed per thread before it is closed
MAX_REVISIONS=5

# MOCK_MODE=true skips GitHub + OpenAI (canned PR file, deterministic refactor, fake commit).
# Use it to run the 3 verification test cases without credentials.
MOCK_MODE=false
